# Supabase → Project Settings → API (clés PUBLIQUES, utilisables côté navigateur)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...clé-anon-publique...

# Optionnel : envoi direct du formulaire de contact (ex. https://formspree.io/f/xxxxxxx)
VITE_FORM_ENDPOINT=

# Chatbot Gemini (Google AI Studio) — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Formulaire Google (lien de partage ou d'intégration)
VITE_GOOGLE_FORM_URL=
